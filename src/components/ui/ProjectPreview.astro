---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  volume: string;
  url?: string;
  previewMode?: "live" | "image";
  previewImage?: ImageMetadata;
}

const { title, volume, url, previewMode, previewImage } = Astro.props;
const isLive = previewMode === "live" && Boolean(url);
const isImage = previewMode === "image" && Boolean(previewImage);
const state = isLive ? "live" : isImage ? "image" : "empty";
const projectHost = url ? new URL(url).hostname.replace(/^www\./, "") : "";
---

<section
  class="project-preview"
  aria-labelledby={"project-preview-" + volume}
  data-project-preview={state}
>
  <div class="grid-shell project-preview__shell">
    <header class="project-preview__heading">
      <p>
        <span>02</span>
        <span id={"project-preview-" + volume}>Project preview</span>
      </p>
      <span class="project-preview__status">
        {isLive ? "Live" : isImage ? "Visual" : "Em documentação"}
      </span>
    </header>

    <div class="project-preview__frame">
      <div class="project-preview__bar">
        <span>Project / {volume}</span>
        <span>{projectHost || title}</span>
      </div>

      <div
        class:list={[
          "project-preview__viewport",
          state === "empty" && "project-preview__viewport--empty",
        ]}
      >
        {
          isLive && url ? (
            <iframe
              src={url}
              title={"Prévia interativa do projeto " + title}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
            />
          ) : isImage && previewImage ? (
            <Image
              src={previewImage}
              alt={"Captura real da interface do projeto " + title}
              loading="lazy"
            />
          ) : (
            <div class="project-preview__empty">
              <span aria-hidden="true">—</span>
              <p>Prévia real ainda não cadastrada.</p>
            </div>
          )
        }
      </div>
    </div>

    {
      url && (
        <a
          class="project-preview__external"
          href={url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir projeto <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</section>

<style>
  .project-preview {
    padding-block: clamp(2rem, 6vw, 5rem);
    border-block: var(--border-hairline);
  }

  .project-preview__shell {
    display: grid;
    gap: var(--space-3);
  }

  .project-preview__heading,
  .project-preview__heading p,
  .project-preview__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .project-preview__heading {
    padding-bottom: var(--space-3);
    border-bottom: var(--border-hairline);
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-preview__heading p {
    justify-content: flex-start;
  }

  .project-preview__heading p span:first-child,
  .project-preview__status,
  .project-preview__bar {
    color: var(--ink-soft);
  }

  .project-preview__frame {
    width: min(100%, 75rem);
    margin-inline: auto;
    border: var(--border-hairline);
    background: var(--paper-deep);
  }

  .project-preview__bar {
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border-bottom: var(--border-hairline);
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.04em;
  }

  .project-preview__bar span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: right;
  }

  .project-preview__viewport {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper);
  }

  .project-preview__viewport iframe,
  .project-preview__viewport :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .project-preview__viewport :global(img) {
    object-fit: cover;
    object-position: top center;
  }

  .project-preview__viewport--empty {
    aspect-ratio: auto;
    min-height: clamp(10rem, 24vw, 16rem);
    display: grid;
    place-items: center;
  }

  .project-preview__empty {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-4);
    text-align: center;
    color: var(--ink-soft);
  }

  .project-preview__empty span {
    width: 3rem;
    font-family: var(--font-mono);
  }

  .project-preview__empty p {
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-preview__external {
    justify-self: end;
    padding-block: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 520px) {
    .project-preview__heading,
    .project-preview__bar {
      align-items: flex-start;
    }

    .project-preview__bar {
      flex-direction: column;
      justify-content: center;
      min-height: 3.5rem;
      gap: 0.15rem;
    }

    .project-preview__bar span:last-child {
      max-width: 100%;
      text-align: left;
    }
  }
</style>
