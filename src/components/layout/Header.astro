---
import { siteUrl } from "../../utils/urls";

interface NavItem {
  number: string;
  label: string;
  href: string;
}

const items: NavItem[] = [
  { number: "001", label: "Sobre", href: siteUrl("", "sobre") },
  { number: "002", label: "Projetos", href: siteUrl("", "projetos") },
  { number: "003", label: "Serviços", href: siteUrl("", "servicos") },
  { number: "004", label: "Contato", href: siteUrl("", "contato") },
];
---

<header class="site-header">
  <nav class="site-header__nav" aria-label="Navegação principal">
    <ol class="site-header__list">
      {
        items.map((item, index) => (
          <li class="site-header__item">
            <a href={item.href} class="site-header__link">
              <span
                class="site-header__number"
                data-motion-depth="2"
                data-motion-x={index % 2 === 0 ? 0.65 : -0.65}
                data-motion-y="0.45"
              >
                {item.number}
              </span>
              <span
                class="site-header__jp jp"
                data-motion-depth="1"
                data-motion-x={index % 2 === 0 ? -0.6 : 0.6}
                data-motion-y="0.35"
                aria-hidden="true"
              >
                私ーて
              </span>
              <span
                class="site-header__label"
                data-motion-depth="1.5"
                data-motion-x={index % 2 === 0 ? 0.55 : -0.55}
                data-motion-y="-0.4"
              >
                {item.label}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="site-header__volume">
      <span class="site-header__volume-main" data-motion-depth="2" data-motion-x="-0.6" data-motion-y="0.4">VOLUME 01</span>
      <span class="site-header__volume-sub" data-motion-depth="1" data-motion-x="0.55" data-motion-y="-0.35">EDIÇÃO 2026</span>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: var(--border-hairline);
    min-height: var(--header-height);
  }

  .site-header__nav {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--grid-margin);
    display: flex;
    align-items: stretch;
    min-height: var(--header-height);
  }

  .site-header__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    flex: 1;
  }

  .site-header__item {
    border-right: var(--border-hairline);
  }

  .site-header__item:first-child {
    border-left: var(--border-hairline);
  }

  .site-header__link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    padding: var(--space-2) clamp(0.35rem, 1.5vw, var(--space-3));
    height: 100%;
    min-width: 0;
  }

  .site-header__link:hover .site-header__label,
  .site-header__link:focus-visible .site-header__label {
    color: var(--red);
  }

  .site-header__number {
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.25vw, 0.85rem);
    color: var(--ink);
    font-weight: 500;
  }

  .site-header__jp {
    font-size: clamp(0.52rem, 1vw, 0.68rem);
    color: var(--ink-soft);
    line-height: 1;
  }

  .site-header__label {
    font-family: var(--font-mono);
    font-size: clamp(0.52rem, 1vw, 0.72rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .site-header__volume {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 0.15rem;
    padding-inline: var(--space-4);

    white-space: nowrap;
  }

  .site-header__volume-main {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .site-header__volume-sub {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
  }

  @media (min-width: 820px) {
    .site-header__volume {
      display: flex;
    }
  }

  @media (max-width: 620px) {
    .site-header__jp {
      display: none;
    }
    .site-header__link {
      padding-inline: clamp(0.25rem, 2vw, var(--space-2));
    }

    .site-header__label {
      letter-spacing: 0;
    }
  }

  @media (max-width: 374px) {
    .site-header__label {
      font-size: 0.48rem;
    }
  }
</style>
