---
interface NavItem {
  number: string;
  label: string;
  href: string;
}

const items: NavItem[] = [
  { number: "01", label: "Sobre", href: "#sobre" },
  { number: "02", label: "Projetos", href: "#projetos" },
  { number: "03", label: "Serviços", href: "#servicos" },
  { number: "04", label: "Contato", href: "#contato" },
];
---

<header class="site-header">
  <nav class="site-header__nav" aria-label="Navegação principal">
    <ol class="site-header__list">
      {
        items.map((item) => (
          <li class="site-header__item">
            <a href={item.href} class="site-header__link">
              <span class="site-header__number">{item.number}</span>
              <span class="site-header__jp jp" aria-hidden="true">私ーて</span>
              <span class="site-header__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="site-header__volume">
      <span class="site-header__volume-main">VOLUME 01</span>
      <span class="site-header__volume-sub">EDIÇÃO 2026</span>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: var(--border-hairline);
  }

  .site-header__nav {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--grid-margin);
    display: flex;
    align-items: stretch;
  }

  .site-header__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    flex: 1;
  }

  .site-header__item {
    border-left: var(--border-hairline);
  }

  .site-header__item:first-child {
    border-left: none;
  }

  .site-header__link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-3) var(--space-3);
    height: 100%;
  }

  .site-header__link:hover .site-header__label,
  .site-header__link:focus-visible .site-header__label {
    color: var(--red);
  }

  .site-header__number {
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    color: var(--ink-soft);
  }

  .site-header__jp {
    font-size: 0.7rem;
    color: var(--ink-soft);
    line-height: 1;
  }

  .site-header__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .site-header__volume {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 0.15rem;
    padding-left: var(--space-4);
    border-left: var(--border-hairline);
    white-space: nowrap;
  }

  .site-header__volume-main {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .site-header__volume-sub {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
  }

  @media (min-width: 720px) {
    .site-header__volume {
      display: flex;
    }
  }

  @media (max-width: 560px) {
    .site-header__jp {
      display: none;
    }
    .site-header__link {
      padding: var(--space-2);
    }
  }
</style>
