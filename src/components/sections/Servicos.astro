---
interface Service {
  kicker: string;
  title: string;
  description: string;
  tools: string[];
}

const services: Service[] = [
  {
    kicker: "Especialidade Principal",
    title: "Design de Web Sites",
    description:
      "Do conceito ao código. Criação de sistemas de design coerentes, escaláveis e centrados na experiência do usuário — com atenção obsessiva aos detalhes que a maioria ignora.",
    tools: ["HTML", "CSS", "JavaScript", "Typescript", "Next.js", "React"],
  },
  {
    kicker: "Serviço Adicional",
    title: "Designer Gráfico",
    description:
      "Da mente para a tela. Crio logos, monto identidades visuais, modernizo marcas. Cada arte feita torna a marca mais profissional e autêntica.",
    tools: ["Canva", "Figma", "Photoshop"],
  },
];
---

<section id="servicos" class="servicos" aria-labelledby="servicos-title">
  <div class="grid-shell">
    <header class="section-heading panel">
      <span>
        <span class="chapter-label" data-motion-depth="2" data-motion-x="-0.7" data-motion-y="0.45">CHAPTER 03</span>
        <h2 id="servicos-title" class="section-heading__title" data-motion-depth="5" data-motion-x="0.8" data-motion-y="0.55">Serviços</h2>
        <span class="section-heading__jp jp" data-motion-depth="2" data-motion-x="-0.65" data-motion-y="0.4">お願い、二人きりでいたい</span>
      </span>
      <span class="section-heading__mark" data-motion-depth="3" aria-hidden="true"></span>
    </header>

    <div class="servicos__grid">
      {
        services.map((service, index) => (
          <article class="servicos__group">
            <div class="panel--dark servicos__card" data-cursor-theme="dark">
              <p class="servicos__kicker" data-motion-depth="2" data-motion-x={index % 2 === 0 ? -0.65 : 0.65} data-motion-y="0.4">{service.kicker}</p>
              <h3 class="servicos__card-title" data-motion-depth="4" data-motion-x={index % 2 === 0 ? 0.75 : -0.75} data-motion-y="0.55">{service.title}</h3>
              <p class="servicos__description" data-motion-depth="3" data-motion-x={index % 2 === 0 ? -0.62 : 0.62} data-motion-y="0.45">{service.description}</p>
              <span class="servicos__index" data-motion-depth="6" data-motion-x={index % 2 === 0 ? 0.78 : -0.78} data-motion-y="-0.55" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <div class="panel servicos__tools-panel">
              <p data-motion-depth="2" data-motion-x={index % 2 === 0 ? -0.6 : 0.6} data-motion-y="0.4">Ferramentas</p>
              <ul class="servicos__tools" aria-label={`Ferramentas para ${service.title}`}>
                {service.tools.map((tool, toolIndex) => (
                  <li class="servicos__tool" data-motion-depth="2.5" data-motion-x={(toolIndex + index) % 2 === 0 ? 0.62 : -0.62} data-motion-y="0.42">{tool}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .servicos {
    padding-block: clamp(2.5rem, 7vw, 7rem);
    border-bottom: var(--border-hairline);
    overflow: clip;
  }

  .servicos__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    width: min(100%, 68rem);
    margin: clamp(2rem, 5vw, 4rem) auto 0;
  }

  .servicos__group {
    min-width: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: clamp(1rem, 3vw, 2rem);
  }

  .servicos__card {
    position: relative;
    min-height: clamp(19rem, 45vw, 24rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    overflow: hidden;
  }

  .servicos__kicker {
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.04em;
    color: rgba(241, 236, 220, 0.55);
  }

  .servicos__card-title {
    max-width: 12ch;
    font-size: clamp(1.65rem, 4vw, 2.6rem);
    line-height: 1.02;
    text-transform: uppercase;
  }

  .servicos__description {
    max-width: 38ch;
    color: rgba(241, 236, 220, 0.72);
    line-height: 1.55;
  }

  .servicos__index {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 0.8;
    color: rgba(241, 236, 220, 0.07);
  }

  .servicos__tools-panel {
    padding: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }

  .servicos__tools-panel > p {
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .servicos__tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .servicos__tool {
    border: var(--border-hairline);
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (min-width: 760px) {
    .servicos__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .servicos__group:nth-child(2) {
      transform: translateY(clamp(0rem, 4vw, 2.5rem));
    }
  }
</style>
