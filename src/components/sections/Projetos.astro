---
import { getCollection } from "astro:content";
import { siteUrl } from "../../utils/urls";
import ProjectCard from "../ui/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProjects = projects.filter((project) => project.data.featured);
const catalogCount = String(projects.length).padStart(2, "0");
const motionVectors = [
  { x: 1, y: 0.72, rotate: 0.65 },
  { x: -0.84, y: 0.68, rotate: -0.58 },
  { x: 0.88, y: -0.62, rotate: 0.52 },
  { x: -0.78, y: -0.58, rotate: -0.48 },
];
---

<section
  id="projetos"
  class="projetos"
  aria-labelledby="projetos-title"
  data-cursor-theme="dark"
>
  <div class="grid-shell">
    <header class="section-heading projetos__header panel--dark">
      <span>
        <span class="chapter-label" data-motion-depth="2" data-motion-x="-0.7" data-motion-y="0.45">CHAPTER 02</span>
        <h2 id="projetos-title" class="section-heading__title" data-motion-depth="5" data-motion-x="0.8" data-motion-y="0.55">Projetos</h2>
        <span class="section-heading__jp jp" data-motion-depth="2" data-motion-x="-0.65" data-motion-y="0.4">どこにいてもいつでも、必ずあなたのもとに戻ってきます。</span>
      </span>
      <span class="section-heading__mark" data-motion-depth="3" aria-hidden="true"></span>
    </header>
  </div>

  <div class="projetos__vitrine" data-vitrine tabindex="-1">
    <div class="projetos__controls grid-shell">
      <p class="projetos__progress" aria-live="polite" data-motion-depth="2" data-motion-x="-0.7" data-motion-y="0.4">
        <span data-vitrine-current>01</span> / {String(featuredProjects.length + 1).padStart(2, "0")}
      </p>
      <span class="projetos__control-buttons" data-motion-depth="4" data-motion-x="0.72" data-motion-y="-0.5">
        <button
          type="button"
          class="projetos__nav-btn"
          data-vitrine-prev
          aria-label="Projeto anterior"
        >
          ←
        </button>
        <button
          type="button"
          class="projetos__nav-btn"
          data-vitrine-next
          aria-label="Próximo projeto"
        >
          →
        </button>
      </span>
    </div>

    <div class="projetos__sticky" data-vitrine-sticky>
      <ul class="projetos__track" data-vitrine-track role="list">
        {
          featuredProjects.map((project, index) => {
            const vector = motionVectors[index % motionVectors.length];
            return (
              <li class="projetos__item" data-project-id={project.id}>
                <div
                  class="projetos__float"
                  data-motion-depth="9"
                  data-motion-x={vector.x}
                  data-motion-y={vector.y}
                  data-motion-rotate={vector.rotate}
                >
                  <ProjectCard project={project} eager={index === 0} />
                </div>
              </li>
            );
          })
        }
        <li class="projetos__item projetos__item--archive">
          <div class="projetos__float" data-motion-depth="7" data-motion-x="0.58" data-motion-y="-0.45" data-motion-rotate="0.25">
            <a href={siteUrl("arquivo")} class="projetos__archive-card">
              <span class="projetos__archive-count" data-motion-depth="6" data-motion-x="-0.7" data-motion-y="0.5">{catalogCount}</span>
              <span class="projetos__archive-label" data-motion-depth="2.5" data-motion-x="0.65" data-motion-y="0.45">
                projetos catalogados, com processo e ficha técnica
              </span>
              <span class="projetos__archive-cta" data-motion-depth="3" data-motion-x="-0.65" data-motion-y="-0.45">
                Ver arquivo completo <span aria-hidden="true">→</span>
              </span>
            </a>
          </div>
        </li>
      </ul>
    </div>

    <div class="grid-shell projetos__hint" data-motion-depth="1.5" data-motion-x="-0.6" data-motion-y="0.4">
      <p>
        <span aria-hidden="true">← →</span>
        <span data-vitrine-instruction>Arraste ou use as setas</span>
      </p>
      <p>Continuar a leitura <span aria-hidden="true">↓</span></p>
    </div>
  </div>
</section>

<style>
  .projetos {
    background: var(--black);
    color: var(--paper);
    padding-block: clamp(2.5rem, 7vw, 6rem) var(--space-5);
    overflow: clip;
  }

  .projetos__header {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    color: var(--paper);
  }

  .projetos__header .chapter-label,
  .projetos__header .section-heading__jp {
    color: rgba(241, 236, 220, 0.58);
  }

  .projetos__header .section-heading__mark {
    background: rgba(241, 236, 220, 0.65);
  }

  .projetos__vitrine {
    position: relative;
    outline: 0;
  }

  .projetos__controls {
    min-height: 3rem;
    padding-bottom: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .projetos__progress {
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    color: rgba(241, 236, 220, 0.58);
  }

  .projetos__control-buttons {
    display: flex;
    gap: var(--space-2);
  }

  .projetos__nav-btn {
    width: 2.75rem;
    height: 2.75rem;
    border: var(--border-hairline-dark);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    display: grid;
    place-items: center;
    transition: background 0.15s ease, color 0.15s ease, opacity 0.15s ease;
  }

  .projetos__nav-btn:hover,
  .projetos__nav-btn:focus-visible {
    background: var(--paper);
    color: var(--black);
  }

  .projetos__nav-btn:disabled {
    opacity: 0.28;
    cursor: not-allowed;
  }

  .projetos__sticky {
    height: auto;
    overflow: hidden;
    display: flex;
    align-items: center;
    perspective: 1200px;
  }

  .projetos__track {
    display: flex;
    gap: var(--grid-gutter);
    width: 100%;
    min-width: 0;
    padding-inline: var(--grid-margin);
    padding-block: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
    overscroll-behavior-inline: contain;
    cursor: grab;
  }

  .projetos__track[data-dragging="true"] {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .projetos__track::-webkit-scrollbar {
    display: none;
  }

  .projetos__item {
    flex: 0 0 auto;
    width: min(calc(100vw - var(--grid-margin) * 2), 24rem);
    min-width: 0;
    display: flex;
    scroll-snap-align: start;
  }

  .projetos__float {
    width: 100%;
    height: 100%;
    display: flex;
    transform-style: preserve-3d;
  }

  .projetos__archive-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
    min-height: clamp(31rem, 72vw, 38rem);
    border: var(--border-hairline-dark);
    padding: clamp(1rem, 3vw, 1.75rem);
    background: linear-gradient(145deg, rgba(255,255,255,0.035), transparent 60%);
    transition: background 0.18s ease, color 0.18s ease;
  }

  .projetos__archive-card:hover,
  .projetos__archive-card:focus-visible {
    color: var(--paper);
    background: rgba(241, 236, 220, 0.09);
  }

  .projetos__archive-count {
    font-family: var(--font-display);
    font-size: clamp(4rem, 13vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
  }

  .projetos__archive-label {
    max-width: 24ch;
    font-size: var(--step-body);
    color: rgba(241, 236, 220, 0.7);
  }

  .projetos__archive-card:hover .projetos__archive-label,
  .projetos__archive-card:focus-visible .projetos__archive-label {
    color: var(--paper);
  }

  .projetos__archive-cta {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .projetos__hint {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    color: rgba(241, 236, 220, 0.5);
  }

  .projetos__hint p:last-child {
    text-align: right;
  }

  .projetos__vitrine[data-vitrine-mode="desktop"] .projetos__sticky {
    height: calc(100svh - var(--header-height));
    min-height: 42rem;
  }

  .projetos__vitrine[data-vitrine-mode="desktop"] .projetos__track {
    width: max-content;
    max-width: none;
    overflow: visible;
    scroll-snap-type: none;
    touch-action: auto;
    cursor: default;
    will-change: transform;
  }

  @media (min-width: 700px) {
    .projetos__item {
      width: min(44vw, 25rem);
    }
  }

  @media (min-width: 1100px) {
    .projetos__item {
      width: clamp(21rem, 29vw, 26rem);
    }
  }

  @media (max-width: 520px) {
    .projetos__controls {
      align-items: end;
    }

    .projetos__hint p:last-child {
      display: none;
    }
  }
</style>
