---
import quoteImg from "../../assets/characters/quote-bleach.webp";
import { Image } from "astro:assets";
---

<section class="quote" aria-label="Citação" data-cursor-theme="dark">
  <div class="quote__figure" data-motion-depth="15" data-motion-x="0.9" data-motion-y="0.78" aria-hidden="true">
    <Image
      src={quoteImg}
      alt=""
      width={735}
      height={648}
      loading="lazy"
    />
  </div>
  <div class="grid-shell quote__shell">
    <blockquote class="quote__text" data-motion-depth="5" data-motion-x="-0.75" data-motion-y="0.58">
      <p>
        “ Corro para obter<br />
        Tudo aquilo que perdi.<br />
        Sangue, carne, ossos<br />
        E algo mais ”.
      </p>
      <cite class="quote__cite" data-motion-depth="2" data-motion-x="0.65" data-motion-y="-0.42">Tite Kubo — Bleach</cite>
    </blockquote>
  </div>
</section>

<style>
  .quote {
    position: relative;
    background: var(--black);
    color: var(--paper);
    min-height: 100svh;
    padding-block: clamp(4rem, 12vw, 9rem);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .quote__figure {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.16;
    pointer-events: none;
  }

  .quote__figure :global(img) {
    height: min(135%, 70rem);
    width: auto;
    filter: grayscale(1) contrast(1.1);
    object-fit: cover;
  }

  .quote__shell {
    position: relative;
    width: 100%;
  }

  .quote__text {
    max-width: 20ch;
    margin-inline: auto;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7vw, 6.25rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .quote__cite {
    display: block;
    margin-top: var(--space-4);
    font-style: normal;
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.08em;
    color: rgba(241, 236, 220, 0.6);
    text-transform: none;
  }

  @media (max-width: 700px) {
    .quote__figure {
      opacity: 0.1;
    }
  }
</style>
