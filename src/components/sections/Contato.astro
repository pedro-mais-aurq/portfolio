---
import whatsappImg from "../../assets/characters/contato-whatsapp.webp";
import emailImg from "../../assets/characters/contato-email.webp";
import instagramImg from "../../assets/characters/contato-instagram.webp";
import { Image } from "astro:assets";
import { contact } from "../../data/contact";
import ContactIcon from "../ui/ContactIcon.astro";

const channels = [
  {
    id: "whatsapp" as const,
    number: "01",
    label: "WhatsApp",
    detail: contact.phoneLabel,
    href: contact.whatsappUrl,
    image: whatsappImg,
    alt: "Personagem em traço apontando para o símbolo do WhatsApp",
  },
  {
    id: "email" as const,
    number: "02",
    label: "E-mail",
    detail: contact.email,
    href: contact.emailUrl,
    image: emailImg,
    alt: "Personagem em traço interagindo com um envelope de e-mail",
  },
  {
    id: "instagram" as const,
    number: "03",
    label: "Instagram",
    detail: contact.instagramLabel,
    href: contact.instagramUrl,
    image: instagramImg,
    alt: "Personagem em traço caminhando sobre o símbolo do Instagram",
  },
];
---

<section id="contato" class="contato" aria-labelledby="contato-title">
  <div class="grid-shell">
    <header class="section-heading panel">
      <span>
        <span class="chapter-label" data-motion-depth="2" data-motion-x="-0.7" data-motion-y="0.45">CHAPTER 04</span>
        <h2 id="contato-title" class="section-heading__title" data-motion-depth="5" data-motion-x="0.8" data-motion-y="0.55">Contato</h2>
        <span class="section-heading__jp jp" data-motion-depth="2" data-motion-x="-0.65" data-motion-y="0.4">接触・仕事を始めましょう</span>
      </span>
      <span class="section-heading__mark" data-motion-depth="3" aria-hidden="true"></span>
    </header>
  </div>

  <ul class="contato__grid" role="list">
    {
      channels.map((channel, index) => (
        <li class={`contato__panel contato__panel--${channel.id}`}>
          <a
            class="contato__link"
            href={channel.href}
            target={channel.id !== "email" ? "_blank" : undefined}
            rel={channel.id !== "email" ? "noopener noreferrer" : undefined}
            aria-label={`${channel.label}: ${channel.detail}`}
          >
            <div class="contato__stage">
              <div class="contato__figure" data-motion-depth="15" data-motion-x={index % 2 === 0 ? 0.88 : -0.88} data-motion-y={index === 2 ? -0.7 : 0.72}>
                <Image
                  src={channel.image}
                  alt={channel.alt}
                  width={400}
                  height={400}
                  loading="lazy"
                />
              </div>
              <div class="contato__icon" data-motion-depth="7" data-motion-x={index % 2 === 0 ? -0.78 : 0.78} data-motion-y={index === 1 ? -0.55 : 0.58}>
                <ContactIcon name={channel.id} title={`Símbolo do ${channel.label}`} />
              </div>
            </div>

            <span class="contato__label-row">
              <span class="contato__number" data-motion-depth="5" data-motion-x={index % 2 === 0 ? -0.7 : 0.7} data-motion-y="0.5">{channel.number}</span>
              <span class="contato__label-copy">
                <strong class="contato__name" data-motion-depth="3" data-motion-x={index % 2 === 0 ? 0.66 : -0.66} data-motion-y="0.46">{channel.label}</strong>
                <span class="contato__detail" data-motion-depth="2" data-motion-x={index % 2 === 0 ? -0.6 : 0.6} data-motion-y="-0.4">{channel.detail}</span>
              </span>
              <span class="contato__arrow" data-motion-depth="4" data-motion-x={index % 2 === 0 ? 0.7 : -0.7} data-motion-y="-0.5" aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .contato {
    padding-block: clamp(2.5rem, 7vw, 6rem) 0;
    overflow: clip;
  }

  .contato__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin-top: clamp(2rem, 5vw, 4rem);
    background: var(--hairline);
    border-block: var(--border-hairline);
  }

  .contato__panel {
    min-width: 0;
    background: var(--paper);
  }

  .contato__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    outline-offset: -3px;
  }

  .contato__stage {
    position: relative;
    min-height: clamp(19rem, 85vw, 31rem);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    overflow: hidden;
  }

  .contato__figure {
    position: relative;
    z-index: 2;
    width: min(88%, 25rem);
    height: 100%;
    display: grid;
    place-items: center;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.22s ease;
  }

  .contato__figure :global(img) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .contato__icon {
    position: absolute;
    z-index: 1;
    width: clamp(7rem, 24vw, 10.5rem);
    aspect-ratio: 1;
    color: color-mix(in srgb, var(--ink) 14%, transparent);
    transition: color 0.22s ease, scale 0.22s ease;
  }

  .contato__panel--whatsapp .contato__icon {
    left: 3%;
    top: 29%;
    rotate: -6deg;
  }

  .contato__panel--email .contato__icon {
    left: 4%;
    top: 36%;
    rotate: -8deg;
  }

  .contato__panel--instagram .contato__icon {
    right: 3%;
    top: 31%;
    rotate: 7deg;
  }

  .contato__label-row {
    min-height: 5.3rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-top: var(--border-hairline);
    font-family: var(--font-mono);
  }

  .contato__number,
  .contato__detail {
    font-size: var(--step-caption);
    color: var(--ink-soft);
  }

  .contato__label-copy {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
  }

  .contato__name {
    font-size: var(--step-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contato__detail {
    overflow-wrap: anywhere;
  }

  .contato__arrow {
    font-size: 1.2rem;
  }

  .contato__link:hover .contato__figure,
  .contato__link:focus-visible .contato__figure {
    filter: grayscale(0) contrast(1.02);
  }

  .contato__link:hover .contato__icon,
  .contato__link:focus-visible .contato__icon {
    scale: 1.05;
  }

  .contato__panel--whatsapp .contato__link:hover .contato__icon,
  .contato__panel--whatsapp .contato__link:focus-visible .contato__icon,
  .contato__panel--whatsapp .contato__link:hover .contato__name,
  .contato__panel--whatsapp .contato__link:focus-visible .contato__name {
    color: var(--whatsapp);
  }

  .contato__panel--email .contato__link:hover .contato__icon,
  .contato__panel--email .contato__link:focus-visible .contato__icon,
  .contato__panel--email .contato__link:hover .contato__name,
  .contato__panel--email .contato__link:focus-visible .contato__name {
    color: var(--email-accent);
  }

  .contato__panel--instagram .contato__link:hover .contato__icon,
  .contato__panel--instagram .contato__link:focus-visible .contato__icon {
    color: var(--instagram-2);
  }

  .contato__panel--instagram .contato__link:hover .contato__name,
  .contato__panel--instagram .contato__link:focus-visible .contato__name {
    background: linear-gradient(100deg, var(--instagram-1), var(--instagram-2), var(--instagram-3));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  @media (min-width: 760px) {
    .contato__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .contato__stage {
      min-height: clamp(24rem, 37vw, 36rem);
    }
  }
</style>
