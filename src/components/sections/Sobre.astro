---
import sobreImg from "../../assets/characters/sobre-strongest.webp";
import { Image } from "astro:assets";
---

<section id="sobre" class="sobre" aria-labelledby="sobre-title">
  <div class="grid-shell">
    <div class="panel sobre__header-band">
      <p class="chapter-label">
        <span>CHAPTER #01</span>
      </p>
      <h2 id="sobre-title" class="sobre__title">Sobre</h2>
      <span class="sobre__title-jp jp">戻ってきて、猫ちゃん？</span>
    </div>

    <div class="sobre__grid grid">
      <div class="sobre__text">
        <p class="sobre__lead">
          Técnico em Informática e Designer Gráfico, atuo na criação de
          interfaces e experiências digitais, combinando design visual,
          usabilidade e desenvolvimento front-end para transformar ideias em
          produtos digitais memoráveis.
        </p>

        <div class="sobre__quote-row">
          <span class="sobre__rule" aria-hidden="true"></span>
        </div>

        <p class="sobre__quote jp">「アンドロメダで会おう。」</p>
        <p class="sobre__quote-caption">Você vai carregar este peso.</p>
      </div>

      <div class="sobre__figure">
        <div class="sobre__figure-frame">
          <Image
            src={sobreImg}
            alt="Ilustração editorial de personagem em traço, acompanhando o texto de apresentação"
            width={750}
            height={987}
            loading="lazy"
          />
          <div class="sobre__badge" aria-hidden="true">
            <span>THE</span>
            <span>STRONGEST</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sobre {
    padding-block: var(--space-7);
    border-bottom: var(--border-hairline);
  }

  .sobre__header-band {
    padding: var(--space-4);

    flex-direction: column;
    gap: var(--space-3);
  }

  .sobre__title {
    font-size: var(--step-h2);
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .sobre__title-jp {
    font-size: var(--step-body);
    text-transform: none;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }

  .sobre__grid {
    margin-top: var(--space-5);
    align-items: start;
  }

  .sobre__text {
    grid-column: 1 / -1;
  }

  .sobre__lead {
    font-size: var(--step-lead);
    max-width: 46ch;
    line-height: 1.5;
  }

  .sobre__quote-row {
    margin-block: var(--space-5);
  }

  .sobre__rule {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--hairline);
  }

  .sobre__quote {
    font-size: var(--step-h3);
    line-height: 1.15;
  }

  .sobre__quote-caption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .sobre__figure {
    grid-column: 1 / -1;
    margin-top: var(--space-6);
  }

  .sobre__figure-frame {
    position: relative;
    max-width: 420px;
    margin-inline: auto;
  }

  .sobre__figure-frame :global(img) {
    width: 100%;
    height: auto;
  }

  .sobre__badge {
    position: absolute;
    top: var(--space-3);
    right: -var(--space-2);
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    line-height: 1.4;
    transform: rotate(-8deg);
  }

  @media (min-width: 900px) {
    .sobre__header-band {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
    }

    .sobre__text {
      grid-column: 1 / 7;
    }

    .sobre__figure {
      grid-column: 8 / -1;
      margin-top: 0;
    }

    .sobre__figure-frame {
      margin-inline: 0;
    }
  }
</style>
