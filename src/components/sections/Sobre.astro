---
import sobreImg from "../../assets/characters/sobre-strongest.webp";
import { Image } from "astro:assets";
---

<section id="sobre" class="sobre" aria-labelledby="sobre-title">
  <div class="grid-shell">
    <header class="section-heading panel">
      <span>
        <span class="chapter-label" data-motion-depth="2" data-motion-x="-0.7" data-motion-y="0.45">CHAPTER 01</span>
        <h2 id="sobre-title" class="section-heading__title" data-motion-depth="5" data-motion-x="0.8" data-motion-y="0.55">Sobre</h2>
        <span class="section-heading__jp jp" data-motion-depth="2" data-motion-x="-0.65" data-motion-y="0.4">戻ってきて、猫ちゃん？</span>
      </span>
      <span class="section-heading__mark" data-motion-depth="3" aria-hidden="true"></span>
    </header>

    <div class="sobre__grid grid">
      <div class="sobre__text">
        <p class="sobre__lead" data-motion-depth="3" data-motion-x="-0.65" data-motion-y="0.48">
          Técnico em Informática e Designer Gráfico, atuo na criação de
          interfaces e experiências digitais, combinando design visual,
          usabilidade e desenvolvimento front-end para transformar ideias em
          produtos digitais memoráveis.
        </p>

        <span class="sobre__rule" aria-hidden="true"></span>
        <p class="sobre__quote jp" data-motion-depth="3" data-motion-x="0.68" data-motion-y="-0.48">「アンドロメダで会おう。」</p>
        <p class="sobre__quote-caption" data-motion-depth="1.5" data-motion-x="-0.6" data-motion-y="0.38">Você vai carregar este peso.</p>
      </div>

      <figure class="sobre__figure">
        <div class="sobre__figure-frame" data-motion-depth="15" data-motion-x="0.9" data-motion-y="0.76">
          <Image
            src={sobreImg}
            alt="Ilustração editorial em preto e branco de um personagem acompanhando a apresentação"
            width={750}
            height={987}
            loading="lazy"
          />
          <span class="sobre__badge" data-motion-depth="6" data-motion-x="-0.8" data-motion-y="0.6" aria-hidden="true">
            <span>THE</span>
            <span>STRONGEST</span>
          </span>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .sobre {
    padding-block: clamp(2.5rem, 7vw, 6.5rem);
    border-bottom: var(--border-hairline);
    overflow: clip;
  }

  .section-heading > span:first-child {
    min-width: 0;
  }

  .sobre__grid {
    margin-top: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .sobre__text {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .sobre__lead {
    max-width: 43ch;
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .sobre__rule {
    display: block;
    width: min(100%, 34rem);
    height: 1px;
    margin-block: clamp(1.5rem, 4vw, 3rem) var(--space-3);
    background: var(--hairline);
  }

  .sobre__quote {
    font-size: clamp(1rem, 2.2vw, 1.45rem);
    line-height: 1.15;
  }

  .sobre__quote-caption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .sobre__figure {
    grid-column: 1 / -1;
    margin-top: var(--space-6);
  }

  .sobre__figure-frame {
    position: relative;
    width: min(100%, 25rem);
    margin-inline: auto;
    border: var(--border-hairline);
    background: var(--paper-2);
    overflow: visible;
  }

  .sobre__figure-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    scale: 1.015;
    transform-origin: bottom center;
  }

  .sobre__badge {
    position: absolute;
    top: 8%;
    right: clamp(-0.5rem, -2vw, -1.25rem);
    width: clamp(5.25rem, 12vw, 7.5rem);
    aspect-ratio: 1;
    border-radius: 48% 52% 46% 54% / 54% 43% 57% 46%;
    border: 1px solid var(--ink);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-mono);
    font-size: clamp(0.55rem, 1vw, 0.68rem);
    letter-spacing: 0.08em;
    line-height: 1.35;
    rotate: -8deg;
  }

  @media (min-width: 900px) {
    .sobre__text {
      grid-column: 1 / 7;
    }

    .sobre__figure {
      grid-column: 8 / -1;
      margin-top: 0;
    }

    .sobre__figure-frame {
      margin-inline: 0 0;
    }
  }
</style>
