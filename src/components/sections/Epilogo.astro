---
const year = new Date().getFullYear();
import Logo from "../../assets/logo/logo_branca.svg";
---

<footer class="epilogo" aria-label="Encerramento">
  <div class="grid-shell epilogo__shell">
    <p class="epilogo__kicker">
      <span class="epilogo__kicker-number">Epílogo</span>
      <span class="epilogo__kicker-sep">#05</span>
    </p>

    <!-- placeholder: logo final do macaco a ser fornecido pelo cliente -->
    <Logo class="epilogo__logo" />

    <h2 class="epilogo__wordmark">Neres</h2>
    <p class="epilogo__subtitle">Web Design</p>
    <p class="epilogo__tagline">Projetos digitais com direção editorial.</p>

    <div class="epilogo__footer">
      <span>@neres.web</span>
      <span>nerescode@gmail.com</span>
      <span>(31) 98248-1194</span>
      <span>Belo Horizonte</span>
      <span>{year} Pedro Neres</span>
    </div>
  </div>
</footer>

<style>
  .epilogo {
    background: var(--black);
    color: var(--paper);
    padding-block: var(--space-8);
  }

  .epilogo__shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .epilogo__kicker {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(241, 236, 220, 0.55);
    align-self: flex-start;
  }

  .epilogo__logo {
    color: var(--paper);
    width: 30rem;
    margin-top: var(--space-2);
    margin-bottom: -300px;
  }

  .epilogo__wordmark {
    font-size: var(--step-h1);
    letter-spacing: 0.08em;
  }

  .epilogo__subtitle {
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(241, 236, 220, 0.7);
    margin-top: -0.5rem;
  }

  .epilogo__tagline {
    margin-top: var(--space-5);
    font-style: italic;
    color: rgba(241, 236, 220, 0.75);
  }

  .epilogo__footer {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step-caption);
    color: rgba(241, 236, 220, 0.55);
  }
</style>
