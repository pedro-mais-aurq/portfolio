---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Epilogo from "../components/sections/Epilogo.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Arquivo completo — Pedro Neres"
  description="Todos os projetos, experimentos e trabalhos de Pedro Neres reunidos em um único volume."
>
  <Header />
  <main id="conteudo">
    <section class="arquivo">
      <div class="grid-shell arquivo__header">
        <p class="chapter-label">
          <span><a href="/#projetos">← Voltar</a></span>
        </p>
        <h1 class="arquivo__title">Arquivo Completo</h1>
        <p class="arquivo__title-jp jp">全作品</p>
      </div>

      <div class="grid-shell">
        <ul class="arquivo__grid" role="list">
          {
            projects.map((project, i) => (
              <li>
                <ProjectCard project={project} eager={i < 2} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Epilogo />
</BaseLayout>

<style>
  .arquivo {
    background: var(--black);
    color: var(--paper);
    padding-block: var(--space-7);
  }

  .arquivo__header {
    padding-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .arquivo__header .chapter-label a {
    color: rgba(241, 236, 220, 0.6);
    text-decoration: underline;
  }

  .arquivo__title {
    font-size: var(--step-h1);
  }

  .arquivo__title-jp {
    color: rgba(241, 236, 220, 0.6);
  }

  .arquivo__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gutter);
  }

  @media (min-width: 700px) {
    .arquivo__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .arquivo__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
