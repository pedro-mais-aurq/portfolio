---
import { ClientRouter } from "astro:transitions";

import "@fontsource/big-shoulders/700.css";
import "@fontsource/big-shoulders/600.css";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/600.css";
import "@fontsource/shippori-mincho/500.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";

import "../styles/reset.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL;
const faviconHref = `${base}${base.endsWith("/") ? "" : "/"}favicon.ico`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />

    <title>{title}</title>

    <link
      rel="icon"
      type="image/png"
      href={faviconHref}
    />

    <ClientRouter />
  </head>

  <body>
    <a href="#conteudo" class="skip-link">
      Pular para o conteúdo
    </a>

    <slot />
    <div
      class="site-cursor"
      data-site-cursor
      data-cursor-visible="false"
      aria-hidden="true"
    ></div>
    <div class="paper-grain" data-motion-depth="2" aria-hidden="true"></div>
    <script>
      import "../scripts/site-lifecycle";
    </script>
  </body>
</html>
